    {
      "id": "c44f7842-16cf-4d94-80a7-cd551838fab5",
      "name": "Notify Business Owner",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        3080,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ (() => { const rows = $('Get Business Info').all().map(r => r.json); const re = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/; const pick = row => Object.values(row).find(v => typeof v === 'string' && re.test(v.trim())); const owner = rows.find(r => Object.values(r).some(v => typeof v === 'string' && /owner/i.test(v)) && pick(r)); const any = owner || rows.find(r => pick(r)); return any ? pick(any).trim() : ''; })() }}",
        "subject": "=Sara handled an email reply: {{ $('Normalize Decision').first().json.action }} - {{ $('Pick Matching Appointment').first().json.customer_name }}",
        "emailType": "text",
        "message": "={{ $('Normalize Decision').first().json.owner_note }}\n\nCustomer: {{ $('Pick Matching Appointment').first().json.customer_name }} ({{ $('Extract Email Data').first().json.from_email }})\nAppointment: {{ $('Normalize Decision').first().json.appointment_id }}\nService: {{ $('Pick Matching Appointment').first().json.service }}\nOriginal time: {{ $('Normalize Decision').first().json.old_datetime }}\nNew time: {{ $('Normalize Decision').first().json.new_datetime || 'unchanged' }}\n\nTheir message:\n{{ $('Extract Email Data').first().json.reply_text }}\n\nSara's reply:\n{{ $('Normalize Decision').first().json.reply_body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    },
