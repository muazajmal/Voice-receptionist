    {
      "id": "b83e8ba3-ca83-4fe2-80fe-63d638b3dcee",
      "name": "Pick Matching Appointment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const clients = $('Get All Clients').all().map(i => i.json);\nconst email = $('Extract Email Data').first().json;\nconst from = email.from_email;\nconst ref = email.ref;\nconst candidates = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  if (r.error || !r.id) continue;\n  if (String(r.email || '').toLowerCase().trim() !== from) continue;\n  const pi = Array.isArray(item.pairedItem) ? item.pairedItem[0] : item.pairedItem;\n  const idx = pi && typeof pi.item === 'number' ? pi.item : 0;\n  const client = clients[idx] || {};\n  if (!client.sheet_id) continue;\n  candidates.push(Object.assign({}, r, { sheet_id: client.sheet_id }));\n}\nif (candidates.length === 0) return [];\nlet pick = ref ? candidates.find(c => c.id === ref) : null;\nif (!pick) {\n  const active = candidates.filter(c => String(c.status || '').toLowerCase() !== 'cancelled');\n  const pool = active.length ? active : candidates;\n  pool.sort((a, b) => String(b.created_at || '').localeCompare(String(a.created_at || '')));\n  pick = pool[0];\n}\nreturn [{ json: {\n  appointment_id: pick.id,\n  customer_name: pick.customer_name || email.from_name,\n  service: pick.service || '',\n  datetime: pick.datetime || '',\n  status: pick.status || '',\n  sheet_id: pick.sheet_id\n} }];"
      }
    },
